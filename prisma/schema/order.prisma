model Order {
    id           String      @id @default(uuid())
    queue_number Int?        
    name         String
    email        String
    whatsapp     String
    story        String?     @db.Text
    package_type String
    details      String?
    status       OrderStatus @default(DRAFT)
    total_price  Decimal?    @db.Decimal(12, 2)
    asset_link   String?
    preview_link String?
    
    // Relasi
    items        OrderItem[] 
    invoice      Invoice?
    
    created_at   DateTime    @default(now())
    updated_at   DateTime    @updatedAt

    @@map("order")
}
