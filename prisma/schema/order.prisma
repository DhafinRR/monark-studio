model Order {
    id          String   @id @default(uuid())
    queueNumber Int?
    name        String
    email       String
    whatsapp    String
    packageType String
    details     String
    status      String   @default("new")
    price       Decimal? @db.Decimal(12, 2)
    assetLink   String?
    previewLink String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
