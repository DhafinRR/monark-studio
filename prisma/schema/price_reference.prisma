model PriceReference {
    id          String   @id @default(uuid())
    key         String   @unique // Misal: "difficulty_easy", "feature_auth"
    name        String   // Nama yang tampil di UI
    category    String   // "catalog" atau "difficulty"
    price       Decimal  @db.Decimal(12, 2)
    description String?
    updatedAt   DateTime @updatedAt

    @@map("price_reference")
}
