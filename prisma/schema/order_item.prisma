model OrderItem {
  id          String              @id @default(uuid())
  order_id    String
  type           ItemType                @default(CATALOG)
  classification OrderItemClassification @default(STANDARD)
  description    String
  price          Decimal                 @db.Decimal(12, 2)
  level          ComplexityLevel?
  sub_level      ComplexitySubLevel?
  reason         String?
  custom_note    String?
  feature_id     String?
  created_at     DateTime                @default(now())
  order       Order               @relation(fields: [order_id], references: [id])

  @@map("order_item")
}
