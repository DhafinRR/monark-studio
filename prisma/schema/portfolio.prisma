model PortfolioProject {
    id               String      @id @default(uuid())
    title            String
    description      String 
    full_description String?     @db.Text 
    type             ProjectType @default(WEB)
    image_url        String 
    gallery          String[] 
    stacks           TechStack[] 
    features         String[] 
    client_name      String?
    project_url      String?
    created_at       DateTime    @default(now())

    @@map("portfolio_project")
}
