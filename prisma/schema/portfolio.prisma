model PortfolioProject {
  id               String      @id @default(uuid())
  title            String
  description      String
  full_description String?
  type             ProjectType @default(WEB)
  image_url        String
  gallery          String[]
  features         String[]
  client_name      String?
  project_url      String?
  created_at       DateTime    @default(now())
  end_date         DateTime?
  role             String?
  start_date       DateTime?
  status           String?     @default("Live")
  stacks           TechStack[] @relation("PortfolioProjectToTechStack")

  @@map("portfolio_project")
}
